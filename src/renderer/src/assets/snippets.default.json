      "body": [
        "<div class=\"result\">",
        "  <span class=\"label\">${1:À retenir}</span>",
        "  <div class=\"value\">${2:Texte}</div>",
        "</div>",
        "",
        "$0"
      ],
      "id": "result"
    },
    {
      "prefix": "result-warn",
      "name": "Résultat (jaune)",
      "description": "Bloc .result.warn pour les points importants",
      "category": "Blocs",
      "scope": "html",
      "body": [
        "<div class=\"result warn\">",
        "  <span class=\"label\">⚠️ ${1:Point important}</span>",
        "  <div class=\"value\" style=\"font-size:1.05em\">${2:Texte}</div>",
        "</div>",
        "",
        "$0"
      ],
      "id": "result-warn"
    },
    {
      "prefix": "result-bad",
      "name": "Résultat (rouge)",
      "description": "Bloc .result.bad pour les erreurs",
      "category": "Blocs",
