        "<h2>${1:1. Titre de section}</h2>",
        "",
        "$0"
      ],
      "id": "h2"
    },
    {
      "prefix": "h3",
      "name": "Sous-titre",
      "description": "<h3> violet",
      "category": "Structure",
      "scope": "html",
      "body": [
        "<h3>${1:Sous-titre}</h3>",
