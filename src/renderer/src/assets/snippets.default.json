{
  "version": 1,
  "trigger": "/",
  "snippets": [
    {
      "prefix": "page",
      "name": "Page complète (thème sombre)",
      "description": "Squelette HTML relié au thème partagé .theme/notes.css",
      "category": "Structure",
      "scope": "html",
      "body": [
        "<!DOCTYPE html>",
        "<html lang=\"fr\">",
        "<head>",
        "<meta charset=\"UTF-8\">",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">",
        "<title>${1:Titre}</title>",
        "<link rel=\"stylesheet\" href=\"${NOTES_THEME}\" data-nf-theme>",
        "</head>",
        "<body>",
        "<div class=\"container\">",
        "",
        "  <h1>${2:Titre}</h1>",
        "  <p class=\"subtitle\">${3:Sous-titre}</p>",
        "",
        "  <h2>${4:1. Première section}</h2>",
        "",
        "  $0",
        "",
        "  <footer>${5:Fiche générée pour révision}</footer>",
        "",
        "</div>",
        "</body>",
        "</html>"
      ],
      "id": "page"
    },
    {
