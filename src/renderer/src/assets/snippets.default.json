      "name": "Note (analogie)",
      "description": "Bloc .note en pointillés jaunes",
      "category": "Blocs",
      "scope": "html",
      "body": [
        "<div class=\"note\">",
        "  <span class=\"label\">🧠 ${1:Analogie du quotidien}</span>",
        "  <p>${2:Texte}</p>",
        "</div>",
        "",
        "$0"
      ],
      "id": "note"
    },
    {
      "prefix": "piege",
      "name": "Note (piège / attention)",
      "description": "Bloc .note avec ⚠️",
      "category": "Blocs",
