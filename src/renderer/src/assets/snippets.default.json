      "scope": "html",
      "body": [
        "<div class=\"duo\" style=\"grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));\">",
        "  <div class=\"result\">",
        "    <span class=\"label\">✅ ${1:Acquis}</span>",
