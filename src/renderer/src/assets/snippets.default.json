        "  </div>",
        "  <div class=\"result bad\">",
        "    <span class=\"label\">❌ ${5:Erreur fréquente}</span>",
        "    <div class=\"value\">${6:À éviter}</div>",
        "  </div>",
        "</div>",
        "",
        "$0"
      ],
      "id": "bilan"
