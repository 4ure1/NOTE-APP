      "description": "Grille auto-adaptative de 3 .step",
      "category": "Mise en page",
      "scope": "html",
      "body": [
        "<div class=\"duo\" style=\"grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));\">",
        "  <div class=\"step orange\">",
        "    <span class=\"label\">${1:Carte 1}</span>",
        "    <ul style=\"margin-left:18px\">",
